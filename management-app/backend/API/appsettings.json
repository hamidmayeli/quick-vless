{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "easy-xray",
    "AccessTokenMinutes": "60",
    "RefreshTokenDays": "30"
  },
  "Storage": {
    "UsersPath": "/data/users.json",
    "AdminsPath": "/data/admins.json",
    "UsageHistoryDir": "/data/usage_history"
  },
  "Xray": {
    "BinaryPath": "xray",
    "ConfigPath": "/usr/local/etc/xray/config.json",
    "StatsServer": "127.0.0.1:10085",
    "InboundTag": "vless-in",
    "Host": "YOUR_SERVER_IP_OR_DOMAIN",
    "Port": "443",
    "RealityPublicKey": "YOUR_REALITY_PUBLIC_KEY",
    "RealityShortId": "YOUR_REALITY_SHORT_ID",
    "Sni": "www.microsoft.com",
    "Fingerprint": "chrome"
  }
}
