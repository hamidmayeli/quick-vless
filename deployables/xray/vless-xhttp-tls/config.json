{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "vless-xhttp-tls",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "mlkem768x25519plus.native.600s.YOUR_VLESS_ENC_PRIVATE_KEY"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "minVersion": "1.2",
          "alpn": ["h2"],
          "certificates": [
            {
              "certificateFile": "/etc/xray/profiles/vless-xhttp-tls/tls/fullchain.pem",
              "keyFile": "/etc/xray/profiles/vless-xhttp-tls/tls/privkey.pem"
            }
          ]
        },
        "xhttpSettings": {
          "path": "/YOUR_XHTTP_ID",
          "mode": "auto"
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block"
      }
    ]
  }
}