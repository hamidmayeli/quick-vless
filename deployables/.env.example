# ── Management App ────────────────────────────────────────────────────────────
# Strong random secret (min 32 chars) — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-string-at-least-32-chars

# Domain used by Caddy to issue a TLS cert for the management UI.
# Keep its DNS record "DNS only" (not proxied) if the domain is on Cloudflare.
MANAGEMENT_DOMAIN=manage.example.com

# ── Xray profiles ─────────────────────────────────────────────────────────────
# Profile active on first start. Afterwards the super admin picks it on the
# Profiles page. One of the folders in xray/: vless-reality, vless-cf-ws, …
XRAY_DEFAULT_PROFILE=vless-reality

# ── REALITY profile (xray/vless-reality) ──────────────────────────────────────
# Public IP or domain of this server (included in vless:// URLs given to users).
# Must not be proxied by Cloudflare.
XRAY_HOST=your-server.com
# Note: Xray always listens on 443 internally. Caddy owns the host port 443 and
# routes VPN traffic to Xray by SNI passthrough — no separate port needed.

# Generate a key pair with: docker run --rm teddysun/xray xray x25519
XRAY_REALITY_PRIVATE_KEY=YOUR_PRIVATE_KEY   # goes into xray/vless-reality/config.json
XRAY_REALITY_PUBLIC_KEY=YOUR_PUBLIC_KEY     # goes into xray/vless-reality/client-config.template

# 8-char hex short ID — generate with: openssl rand -hex 4
XRAY_REALITY_SHORT_ID=a1b2c3d4

# Site Xray impersonates, and the TLS fingerprint clients mimic
XRAY_SNI=dl.google.com
XRAY_FINGERPRINT=chrome

# ── Cloudflare WebSocket profile (xray/vless-cf-ws) ───────────────────────────
# Optional. A hostname proxied by Cloudflare (orange cloud), one level deep,
# e.g. cdn.example.com. Leave empty to keep this profile disabled.
XRAY_CF_DOMAIN=
# WebSocket path, without the leading slash — generate with: echo "ws-$(openssl rand -hex 12)"
XRAY_WS_ID=
