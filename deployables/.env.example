# ── Management App ────────────────────────────────────────────────────────────
# Strong random secret (min 32 chars) — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-string-at-least-32-chars

# Domain used by Caddy to issue a TLS cert for the management UI.
# Access the app at https://MANAGEMENT_DOMAIN:8443
MANAGEMENT_DOMAIN=manage.example.com

# ── Xray VPN ──────────────────────────────────────────────────────────────────
# Public IP or domain of this server (included in vless:// URLs given to users)
XRAY_HOST=your-server.com
# Note: Xray always listens on 443 internally. Caddy owns the host port 443 and
# routes VPN traffic to Xray by SNI passthrough — no separate port needed.

# Generate a key pair with: docker run --rm teddysun/xray xray x25519
XRAY_REALITY_PRIVATE_KEY=YOUR_PRIVATE_KEY   # goes into deployables/xray/config.json
XRAY_REALITY_PUBLIC_KEY=YOUR_PUBLIC_KEY     # sent to clients in vless:// URL

# 8-char hex short ID — generate with: openssl rand -hex 4
XRAY_REALITY_SHORT_ID=a1b2c3d4

# TLS fingerprint impersonation target
XRAY_SNI=www.microsoft.com
XRAY_FINGERPRINT=chrome
